{
  "name": "@dotaf/core",
  "version": "0.0.0",
  "description": "Engine of dotaf: dotaf.json schema, CSS token generation, config loading, component install and lint runs. The CLI and the MCP server are thin wrappers over it.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dotaf.schema.json"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.js && tsc -p tsconfig.build.json && node scripts/emit-schema.js",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@dotaf/registry": "workspace:*",
    "@dotaf/stylelint-config": "workspace:*",
    "stylelint": "^17.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "postcss": "^8.5.31"
  }
}
