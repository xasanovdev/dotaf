{
  "name": "@dotaf/stylelint-config",
  "version": "0.0.0",
  "description": "Stylelint config with the dotaf/use-tokens rule: design values (color, spacing, radius, font, shadow) must come from var(--dotaf-*).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "stylelint": "^17.16.0"
  },
  "peerDependencies": {
    "stylelint": "^17"
  }
}
