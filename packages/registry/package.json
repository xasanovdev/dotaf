{
  "name": "@dotaf/registry",
  "version": "0.0.0",
  "description": "Component sources (React Aria Components + CSS Modules) and an API to list and read them.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "components",
    "!components/**/*.demo.*",
    "!components/**/*.test.*",
    "!components/AGENTS.md",
    "!components/CLAUDE.md"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc && tsc -p tsconfig.strict.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "typescript": "~6.0.3",
    "vitest-browser-react": "^2.3.0"
  }
}
